
# GoHighLevel inbound webhook for customer lead forms (free water test + site CTA).
# Create in GHL: Automation > Workflows > new workflow > trigger "Inbound Webhook",
# then copy the generated URL here and into the GitHub Actions secret of the same name.
# If unset, lead forms fall back to the Supabase backup table only.
VITE_GHL_LEAD_WEBHOOK_URL=
